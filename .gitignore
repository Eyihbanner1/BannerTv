# Personal test media for the playback lab, see docs/TV_SETUP.md
apps/webos/lab-sources.local.json

# BannerTV Demo: built media (deployed, not committed), downloads and frame reviews
services/demo/public/
services/demo/.work/
services/demo/review/

# Android TV host: Gradle and IDE state, build outputs and signing keys. Never a bare build/,
# because apps/webos/build/ holds source.
apps/androidtv/.gradle/
apps/androidtv/.kotlin/
apps/androidtv/build/
apps/androidtv/**/build/
apps/androidtv/out/
apps/androidtv/local.properties
.idea/
*.apk
*.aab
*.jks
*.keystore

# The phone's update signing key lives only in the EXPO_UPDATES_PRIVATE_KEY secret, never here
# (apps/mobile/app.config.ts). `expo-updates codesigning:generate` writes it as private-key.pem.
private-key.pem
