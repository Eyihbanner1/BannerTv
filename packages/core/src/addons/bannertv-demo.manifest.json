    {
      "type": "movie",
      "id": "blender",
      "name": "Blender open movies",
      "extra": [{ "name": "search" }]
    }
  ],
  "behaviorHints": {
    "adult": false,
    "p2p": false,
    "configurable": false,
    "configurationRequired": false
  }
}
