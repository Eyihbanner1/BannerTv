{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@tv/*": ["../webos/src/*"],
      "@phone/*": ["../mobile/src/*"],
      "@brand/*": ["../../brand/*"],
      "@bannertv/core": ["../../packages/core/src/index.ts"],
      "@bannertv/protocol": ["../../packages/protocol/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "expo": ["./node_modules/expo"],
      "expo-*": ["./node_modules/expo-*"],
      "react-native-svg": ["./node_modules/react-native-svg"],
      "i18next": ["./node_modules/i18next"],
      "react-i18next": ["./node_modules/react-i18next"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "android", "ios"]
}
