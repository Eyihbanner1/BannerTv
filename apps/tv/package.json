{
  "name": "@bannertv/tv-native",
  "version": "0.1.0",
  "private": true,
  "description": "BannerTV for Android TV and Fire TV, native: React Native for TV on the shared core (ADR 0008). Outside the pnpm workspace; see README.md.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc -p tsconfig.json",
