    "export:android": "expo export --platform android --output-dir dist/android",
    "prebuild": "expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "expo": "58.0.22",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-linear-gradient": "58.0.3",
    "expo-splash-screen": "58.0.12",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-video": "58.0.13",
    "i18next": "26.5.11",
    "react": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.7",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.23",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
