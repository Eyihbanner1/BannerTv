<?xml version="1.0" encoding="UTF-8"?>
<!--
  BannerTV for Samsung TVs (Tizen). package.mjs puts the version in and packages this with the web
  build (apps/webos/dist). The application id is where the TV keeps the app's storage, so it must
  never change once people use the app: a new id would lose every addon, profile and bit of
  progress. ADR 0009 says why each line is here.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://bannertv.workers.dev/tizen" version="{{version}}" viewmodes="maximized">
  <tizen:application id="BannerTv01.BannerTV" package="BannerTv01" required_version="3.0"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>BannerTV</name>
  <tizen:profile name="tv-samsung"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
