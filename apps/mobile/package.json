{
  "name": "@bannertv/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "BannerTV for phones: touch-first, upright, React Native (Expo) on the shared core",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bannertv/core": "workspace:*",
    "@bannertv/protocol": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "i18next": "^26.5.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
