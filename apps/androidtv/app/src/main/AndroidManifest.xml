<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        For the cards on Android TV's Watch Next row, as Google's own TV samples declare it. Granted
        at install; on a phone, which has no TV provider, it does nothing.
    -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- One APK for TVs and phones: neither the TV launcher nor a touchscreen is required. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        No backup: WebView storage holds Trakt tokens and addon URLs that carry debrid keys.
        Addons and streams may be plain http, including servers on the local network.
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BannerTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!--
            Every config change is handled in place, so the WebView and the player survive it.
            adjustResize resizes nothing here (the app draws edge to edge), but before Android 11
            it is how the keyboard's height reaches the window insets, which tell the page when
            the keyboard opens and closes.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!--
                bannertv://open?type=…&meta=…&video=…, which a Watch Next card opens (ADR 0005).
                Not BROWSABLE: apps on the device can open it, a web page cannot.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="open"
                    android:scheme="bannertv" />
            </intent-filter>
        </activity>
    </application>
</manifest>
