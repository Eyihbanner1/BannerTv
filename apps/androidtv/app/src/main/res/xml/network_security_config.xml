<?xml version="1.0" encoding="utf-8"?>
<!-- Addons and streams can be plain http, including servers on the local network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
