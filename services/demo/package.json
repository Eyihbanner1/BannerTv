{
  "name": "@bannertv/demo",
  "version": "0.1.0",
  "private": true,
  "description": "BannerTV Demo: a Stremio-protocol addon of Blender's Creative Commons films, as a Cloudflare Worker with the HLS files as static assets",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "art": "node scripts/render-art.mjs",
    "media": "node scripts/prepare-media.mjs",
    "check:live": "node scripts/check-live.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@bannertv/core": "workspace:*",
    "@bannertv/protocol": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5"
  }
}
